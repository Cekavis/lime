{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lime.invalid/schemas/config.schema.json",
  "title": "Lime user configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rime_schema": { "type": "string", "minLength": 1, "maxLength": 128, "default": "rime_ice" },
    "preceding_text_char_limit": { "type": "integer", "minimum": 1, "maximum": 4096, "default": 128 },
    "context_preview_char_limit": { "type": "integer", "minimum": 0, "maximum": 1024, "default": 32 },
    "page_size": { "type": "integer", "minimum": 1, "maximum": 20, "default": 9 },
    "llm_rerank_count": { "type": "integer", "minimum": 1, "maximum": 128, "default": 32, "description": "Length of the leading Rime candidate prefix checked for complete-input candidates before LLM reranking." },
    "llm_effective_count": { "type": "integer", "minimum": 1, "maximum": 32, "default": 3, "description": "Number of top LLM-ranked complete candidates promoted ahead of the Rime order." },
    "llm_context_token_limit": { "type": "integer", "minimum": 1, "maximum": 4096, "default": 1024 },
    "llm_backend": { "type": "string", "enum": ["cuda", "cpu"], "default": "cuda", "description": "Preferred llama.cpp native backend; CUDA falls back to CPU when unavailable." },
    "llm_enabled": { "type": "boolean", "default": true },
    "auto_start_service": { "type": "boolean", "default": false }
  }
}
