{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lime.invalid/schemas/ipc.schema.json",
  "title": "Lime IPC messages",
  "oneOf": [
    {
      "$ref": "#/$defs/handshake_request"
    },
    {
      "$ref": "#/$defs/handshake_response"
    },
    {
      "$ref": "#/$defs/input_request"
    },
    {
      "$ref": "#/$defs/input_response"
    },
    {
      "$ref": "#/$defs/management_request"
    },
    {
      "$ref": "#/$defs/management_response"
    }
  ],
  "$defs": {
    "input_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "preedit",
        "preceding_text",
        "context_available",
        "config_revision"
      ],
      "properties": {
        "request_id": {
          "type": "integer",
          "minimum": 0
        },
        "preedit": {
          "type": "string"
        },
        "preceding_text": {
          "type": "string"
        },
        "context_available": {
          "type": "boolean"
        },
        "config_revision": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_extension_of": {
          "type": "integer",
          "minimum": 0,
          "description": "Original request_id for a lazy Rime candidate extension; skips LLM ranking and history row creation."
        },
        "candidate_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Number of leading candidates to return; the service may read and rerank more internally. Zero uses the full-list behavior."
        }
      }
    },
    "input_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "candidates",
        "context_used",
        "service_state",
        "diagnostics"
      ],
      "properties": {
        "request_id": {
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "candidate_remainders": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "Remaining raw pinyin after selecting each candidate, aligned with candidates. Null means selection metadata is unavailable; an empty string means the candidate consumes the complete composition."
        },
        "context_used": {
          "type": "boolean"
        },
        "service_state": {
          "enum": [
            "ready",
            "rime_only",
            "reloading",
            "unavailable"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate_diagnostic"
          }
        },
        "end_to_end_duration_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "rime_duration_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "llm_performance": {
          "anyOf": [
            {
              "$ref": "#/$defs/llm_performance"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_text",
        "commit_text"
      ],
      "properties": {
        "display_text": {
          "type": "string"
        },
        "commit_text": {
          "type": "string"
        }
      }
    },
    "candidate_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "rime_candidate",
        "llm_candidate",
        "logprob",
        "logprobs",
        "mismatch",
        "display_candidate"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "rime_candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/candidate"
            },
            {
              "type": "null"
            }
          ]
        },
        "llm_candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/candidate"
            },
            {
              "type": "null"
            }
          ]
        },
        "logprob": {
          "type": "number"
        },
        "logprobs": {
          "type": "array",
          "description": "Per-token log probabilities from the shared scoring anchor, including the replayed preceding-text suffix after boundary rollback. Their sum equals logprob within floating point round-off.",
          "items": {
            "type": "number"
          }
        },
        "mismatch": {
          "type": "boolean",
          "description": "Whether joint tokenization changes this candidate's original preceding-text token boundary; all candidates use the same shared scoring anchor."
        },
        "display_candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/candidate"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "llm_boundary_rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefix_token_count",
        "replayed_token_count"
      ],
      "properties": {
        "prefix_token_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Number of original preceding-text tokens before the shared scoring anchor, before left truncation."
        },
        "replayed_token_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Number of original preceding-text tokens replayed after the shared scoring anchor."
        },
        "prefix_text": {
          "type": [
            "string",
            "null"
          ],
          "description": "Exact scorer-context text before the anchor; provided together with replayed_text only when raw token bytes map exactly to a UTF-8 boundary."
        },
        "replayed_text": {
          "type": [
            "string",
            "null"
          ],
          "description": "Exact scorer-context text replayed from the anchor, excluding candidate text; absent together with prefix_text when the boundary cannot be mapped exactly."
        }
      }
    },
    "llm_performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_ms",
        "tokenize_ms",
        "decode_ms",
        "candidate_count",
        "scored_count",
        "target_token_count",
        "batch_count",
        "mismatch_count",
        "context_token_count",
        "decode_input_token_count",
        "logits_output_count"
      ],
      "properties": {
        "total_ms": {
          "type": "integer",
          "minimum": 0
        },
        "tokenize_ms": {
          "type": "integer",
          "minimum": 0
        },
        "decode_ms": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "scored_count": {
          "type": "integer",
          "minimum": 0
        },
        "target_token_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of scored target tokens, including replayed preceding-text suffixes after boundary rollback."
        },
        "batch_count": {
          "type": "integer",
          "minimum": 0
        },
        "mismatch_count": {
          "type": "integer",
          "minimum": 0
        },
        "boundary_rollback": {
          "anyOf": [
            {
              "$ref": "#/$defs/llm_boundary_rollback"
            },
            {
              "type": "null"
            }
          ],
          "description": "Request-wide rollback anchor for joint-tokenized scoring. Absent when no rollback occurred or when reading an older payload."
        },
        "context_token_count": {
          "type": "integer",
          "minimum": 0
        },
        "decode_input_token_count": {
          "type": "integer",
          "minimum": 0
        },
        "logits_output_count": {
          "type": "integer",
          "minimum": 0
        },
        "inference_count_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "omitted_candidate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "input_history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "timestamp_ms",
        "preceding_text",
        "preedit",
        "rime_candidates",
        "final_candidates",
        "service_state",
        "diagnostics"
      ],
      "properties": {
        "request_id": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_to_end_duration_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "preceding_text": {
          "type": "string"
        },
        "preedit": {
          "type": "string"
        },
        "rime_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "final_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "service_state": {
          "enum": [
            "ready",
            "rime_only",
            "reloading",
            "unavailable"
          ]
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "rime_duration_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate_diagnostic"
          }
        },
        "llm_performance": {
          "anyOf": [
            {
              "$ref": "#/$defs/llm_performance"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "input_history_page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "total",
        "page",
        "page_size"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input_history_entry"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "dictionary_page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "total",
        "page",
        "page_size"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dictionary_entry"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "dictionary_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pinyin",
        "text",
        "weight"
      ],
      "properties": {
        "pinyin": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "weight": {
          "type": "integer"
        }
      }
    },
    "model_preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "size_bytes",
        "sha256",
        "loaded"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "loaded": {
          "type": "boolean"
        }
      }
    },
    "model_memory_info": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "context_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "compute_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "total_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "backend": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "breakdown": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "model_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size_bytes",
        "sha256",
        "loaded"
      ],
      "properties": {
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "loaded": {
          "type": "boolean"
        },
        "scoring_path": {
          "anyOf": [
            {
              "enum": [
                "attention",
                "recurrent"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "initialization_memory": {
          "anyOf": [
            {
              "$ref": "#/$defs/model_memory_info"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "weasel_theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "custom"
      ],
      "properties": {
        "base": {
          "type": "string"
        },
        "custom": {
          "type": "string"
        }
      }
    },
    "management_request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "get_config"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "get_status"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "get_weasel_theme"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "unload_model"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "list_model_presets"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "export_dictionary"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "clear_dictionary"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "clear_input_history"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "set_config"
            },
            "payload": {
              "$ref": "#/$defs/config"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "load_model"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "save_model_preset"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "path"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "rename_model_preset"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "new_name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "new_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "delete_model_preset"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "select_model_preset"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "learn"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pinyin",
                "text"
              ],
              "properties": {
                "pinyin": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "get_dictionary_page"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "page",
                "page_size"
              ],
              "properties": {
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "page_size": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "import_dictionary"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entries"
              ],
              "properties": {
                "entries": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/dictionary_entry"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "get_input_history_page"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "page",
                "page_size"
              ],
              "properties": {
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "page_size": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "wait_for_input_history"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "revision"
              ],
              "properties": {
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "get_benchmark_dataset"
            }
          }
        },
        {
          "type": "object",
