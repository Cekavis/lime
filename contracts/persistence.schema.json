{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lime.invalid/contracts/persistence.schema.json",
  "title": "Lime service persistence files",
  "oneOf": [
    { "$ref": "#/$defs/versioned_config" },
    { "$ref": "#/$defs/model_state" }
  ],
  "$defs": {
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rime_schema", "preceding_text_char_limit", "context_preview_char_limit", "page_size", "llm_rerank_count", "llm_effective_count", "llm_context_token_limit", "llm_inference_count_limit", "llm_ignore_emoji", "llm_backend"],
      "properties": {
        "rime_schema": { "type": "string", "minLength": 1, "maxLength": 128 },
        "preceding_text_char_limit": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "context_preview_char_limit": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 20 },
        "llm_rerank_count": { "type": "integer", "minimum": 1, "maximum": 128 },
        "llm_effective_count": { "type": "integer", "minimum": 1, "maximum": 32 },
        "llm_context_token_limit": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "llm_inference_count_limit": { "type": "integer", "minimum": 1, "maximum": 32 },
        "llm_ignore_emoji": { "type": "boolean" },
        "llm_backend": { "enum": ["cuda", "cpu"] }
      }
    },
    "versioned_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "config"],
      "properties": {
        "version": { "const": 1 },
        "config": { "$ref": "#/$defs/config" }
      }
    },
    "model_preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "size_bytes", "sha256", "loaded"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "path": { "type": "string", "minLength": 1 },
        "size_bytes": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "sha256": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "loaded": { "type": "boolean" }
      }
    },
    "model_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "presets"],
      "properties": {
        "version": { "const": 1 },
        "presets": { "type": "array", "items": { "$ref": "#/$defs/model_preset" } },
        "active_model_path": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      }
    }
  }
}
