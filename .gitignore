# Large upstream Rime text assets are fetched and verified by the release scripts.
# Keep only the project-facing documentation, license, and Weasel theme in Git.
third_party/rime/*
!third_party/rime/README.md
!third_party/rime/LICENSE
!third_party/rime/weasel.yaml
!third_party/rime/librime-1.17.0.json
