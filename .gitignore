# Rust / Tauri build output
target/
src-tauri/target/
src-tauri/gen/
src-tauri/icons/
dist/
build/
frontend/node_modules/

# Local models and native runtime binaries
*.gguf
*.bin
*.dll
*.dylib
*.so
*.pdb
*.ilk
*.exe
*.msi
*.dmg

# User data and local runtime state
.lime/
models/
user-data/
logs/
*.userdb/

