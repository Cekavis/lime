{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lime",
  "version": "0.1.0",
  "identifier": "dev.lime.ime",
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lime",
        "width": 520,
        "height": 720,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../target/release/lime-service.exe": "lime-service.exe",
      "../build/tsf/Release/lime-tsf.dll": "lime-tsf.dll",
      "../target/rime-package": "rime",
      "../target/llama-runtime": "llama",
      "../third_party/weasel-ui/LICENSE.txt": "licenses/WeaselUI-GPL-3.0.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "compression": "zlib",
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"],
        "installerHooks": "windows/nsis/hooks.nsh",
        "startMenuFolder": "Lime"
      }
    }
  }
}
